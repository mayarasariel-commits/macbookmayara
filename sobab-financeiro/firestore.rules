rules_version = '2';
// Regras de acesso do Financeiro SOBAB.
// Cole este arquivo inteiro em: Firebase > Firestore Database > Regras > Publicar.
//
// Papéis (campo "papel" em usuarios/{uid}):
//   admin      tudo, inclusive liberar e bloquear acessos
//   financeiro lança, concilia, paga e edita cadastros
//   diretoria  lê tudo e só pode aprovar ou reprovar contas a pagar
//   leitura    só lê
// Quem não tem documento em usuarios, ou está com ativo = false, não lê nem grava nada.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function caminhoPerfil() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function ativo() { return logado() && exists(caminhoPerfil()) && get(caminhoPerfil()).data.ativo == true; }
    function papel() { return get(caminhoPerfil()).data.papel; }
    function admin() { return ativo() && papel() == 'admin'; }
    function edita() { return ativo() && papel() in ['admin', 'financeiro']; }
    function aprova() { return ativo() && papel() in ['admin', 'financeiro', 'diretoria']; }
    function instalado() { return exists(/databases/$(database)/documents/config/instalado); }
    function papelValido(p) { return p in ['admin', 'financeiro', 'diretoria', 'leitura']; }

    // Marca que o sistema já tem administradora. Só nasce junto com o primeiro acesso.
    match /config/instalado {
      allow read: if true;
      allow create: if logado()
        && existsAfter(caminhoPerfil())
        && getAfter(caminhoPerfil()).data.papel == 'admin';
      allow update, delete: if false;
    }

    match /usuarios/{uid} {
      allow read: if ativo() || (logado() && request.auth.uid == uid);
      // Primeiro acesso: a pessoa cria o próprio perfil de admin uma única vez, junto com config/instalado
      allow create: if (admin()
          && papelValido(request.resource.data.papel)
          && request.resource.data.ativo is bool)
        || (logado() && request.auth.uid == uid && !instalado()
          && existsAfter(/databases/$(database)/documents/config/instalado)
          && request.resource.data.papel == 'admin'
          && request.resource.data.ativo == true);
      // A administradora não consegue tirar o próprio acesso (evita ficar trancada para fora)
      allow update: if admin()
        && papelValido(request.resource.data.papel)
        && request.resource.data.ativo is bool
        && (uid != request.auth.uid
          || (request.resource.data.papel == resource.data.papel && request.resource.data.ativo == resource.data.ativo));
      allow delete: if admin() && uid != request.auth.uid;
    }

    match /lanc/{id} {
      allow read: if ativo();
      allow create, delete: if edita();
      // Diretoria: só os campos de aprovação, só em nome próprio
      allow update: if edita()
        || (aprova()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aprov', 'aprovPor', 'aprovEm'])
          && request.resource.data.aprov in ['aprovado', 'reprovado']
          && request.resource.data.aprovPor == request.auth.uid);
    }

    match /meses/{mes} {
      allow read: if ativo();
      allow write: if edita();
    }

    match /cad/{doc} {
      allow read: if ativo();
      allow write: if edita();
    }

    // Qualquer outra coleção fica fechada
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
